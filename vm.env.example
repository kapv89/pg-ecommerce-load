# Copy to vm.env and fill in. vm.env is gitignored — it holds real credentials.
#
#   cp vm.env.example vm.env && nano vm.env
#
# Every setting here can also be given as a flag (--db-host) or an environment
# variable (DB_HOST=...), both of which win over this file.

# --- Cloud SQL for PostgreSQL ------------------------------------------------
# Private IP is the default assumption: same VPC as the VM, no SSL needed, no
# proxy to run. For a public IP either authorise this VM's address in the
# instance's networking settings or run the Cloud SQL Auth Proxy on the VM and
# point DB_HOST at 127.0.0.1.
DB_HOST=10.0.0.3
DB_PORT=5432
DB_NAME=medusa
DB_USER=medusa
DB_PASSWORD=

# true only if the instance enforces SSL. See the note in medusa-config.ts about
# why this relaxes certificate verification.
DB_SSL=false

# --- Memorystore for Redis ---------------------------------------------------
REDIS_HOST=10.0.0.4
REDIS_PORT=6379
# Blank unless AUTH is enabled on the instance.
REDIS_PASSWORD=
# true if in-transit encryption is on.
REDIS_TLS=false
# The app gives each subsystem its own Redis logical database (0 server,
# 1 cache, 2 event bus, 3 workflow engine, 4 locking) so traffic can be
# attributed. Set false on Memorystore *Cluster*, which only has database 0.
REDIS_DB_ISOLATION=true

# --- Application -------------------------------------------------------------
PORT=9000

# Address the browser will use for the admin dashboard, for the CORS lists.
# Left blank, vm-start.sh asks the GCP metadata server for the VM's external IP.
PUBLIC_HOST=

# pm2 sizing. Blank means "derive from core count": half the cores to HTTP
# servers, a fifth to background workers. With Postgres and Redis off the box —
# which is the whole point of this deployment — you can push servers up towards
# the core count.
MEDUSA_SERVER_INSTANCES=
MEDUSA_WORKER_INSTANCES=

# Total Postgres connections the cluster may hold, divided across the processes
# to set each one's pool_max. Must stay under the Cloud SQL instance's
# max_connections with room for psql, the seed scripts and Query Insights.
# Cloud SQL derives max_connections from instance memory — check yours before
# raising this (vm-check.sh prints it).
DB_CONNECTION_BUDGET=700

# --- Credentials the workload driver logs in with ----------------------------
ADMIN_EMAIL=admin@ecommerce-load.local
ADMIN_PASSWORD=supersecret

# Left blank, vm-start.sh reuses whatever is already in packages/app/.env, and
# generates them on a first run. Changing them invalidates existing sessions.
JWT_SECRET=
COOKIE_SECRET=
