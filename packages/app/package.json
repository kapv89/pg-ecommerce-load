{
  "name": "@ecommerce-load/app",
  "version": "0.0.0",
  "private": true,
  "description": "Medusa v2 application that generates the workload under test",
  "license": "MIT",
  "scripts": {
    "run:app": "node ./scripts/start-cluster.mjs",
    "db:setup": "node ./scripts/ensure-env.mjs && medusa db:migrate",
    "db:reset": "node ./scripts/ensure-env.mjs && medusa db:migrate --skip-links=false && medusa exec ./src/scripts/seed.ts && medusa exec ./src/scripts/seed-workload.ts",
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:workload": "medusa exec ./src/scripts/seed-workload.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "seed:orders": "medusa exec ./src/scripts/seed-orders.ts",
    "seed:fulfillments": "medusa exec ./src/scripts/seed-fulfillments.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/caching-redis": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/medusa": "2.18.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": ">=20"
  }
}
