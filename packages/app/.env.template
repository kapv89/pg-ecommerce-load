STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Matches the defaults in packages/infra/docker-compose.yml. If you started the
# infra with POSTGRES_PORT / REDIS_PORT overrides, change them here too.
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa

# One base URL; medusa-config.ts fans it out to a separate Redis logical database
# per subsystem (0 server, 1 caching, 2 event bus, 3 workflow engine, 4 locking).
REDIS_URL=redis://localhost:6379

# Local-only development secrets. Not sensitive; this stack never leaves the host.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
